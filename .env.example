# Configuración de Conexión con Supabase (Ingenio La Unión)
# Reemplaza estos valores con las credenciales de tu proyecto en Supabase (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME="Ingenio La Unión - Control de Quemas"
